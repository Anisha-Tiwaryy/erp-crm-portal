                  "pm.collectionVariables.set('challanId', d.id);",
                  "pm.test('is draft', () => pm.expect(d.status).to.eql('DRAFT'));",
                  "pm.test('stores product snapshot', () => {",
                  "  pm.expect(d.items[0]).to.have.property('productName');",
                  "  pm.expect(d.items[0]).to.have.property('sku');",
