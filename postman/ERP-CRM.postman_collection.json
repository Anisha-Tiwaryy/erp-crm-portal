            "description": "Returns a JWT. The test script saves it to the {{token}} variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erpdemo.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', b.data.token);",
                  "console.log('Logged in as', b.data.user.role);"
                ]
              }
            }
