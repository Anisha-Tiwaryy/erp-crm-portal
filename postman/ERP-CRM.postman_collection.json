{
  "info": {
    "name": "ERP + CRM Operations Portal",
    "description": "REST API for the Mini ERP + CRM case study.\n\nSetup:\n1. Set the collection variable `baseUrl` to your API root (http://localhost:4000 by default).\n2. Run 'Login as Admin' first. It stores the JWT into the `token` variable automatically, and every other request inherits Bearer auth from the collection.\n\nThe folder 'Business Rule Checks' contains the negative cases that demonstrate validation, role gating, and the insufficient-stock guard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "lowStockProductId",
      "value": ""
    },
    {
      "key": "challanId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Unauthenticated liveness probe."
          },
          "response": []
        }
      ]
    },
